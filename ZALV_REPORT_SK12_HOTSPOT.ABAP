*&---------------------------------------------------------------------*
*& Report ZALV_REPORT_SK12_HOTSPOT
*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
REPORT ZALV_REPORT_SK12_HOTSPOT.

TABLES:VBAK.

TYPES: BEGIN OF STR_VBAK,
         VBELN TYPE VBAK-VBELN,
         ERDAT TYPE VBAK-ERDAT,
         ERZET TYPE VBAK-ERZET,
         ERNAM TYPE VBAK-ERNAM,
         ANGDT TYPE VBAK-ANGDT,
         BNDDT TYPE VBAK-BNDDT,
         AUDAT TYPE VBAK-AUDAT,
         VBTYP TYPE VBAK-VBTYP,
         TRVOG TYPE VBAK-TRVOG,
         AUART TYPE VBAK-AUART,
         AUGRU TYPE VBAK-AUGRU,
       END OF STR_VBAK.

*DATA:IT_VBAK TYPE TABLE OF STR_VBAK,
*     WA_VBAK TYPE STR_VBAK.

DATA:IT_FCAT TYPE SLIS_T_FIELDCAT_ALV,
     WA_FCAT TYPE SLIS_FIELDCAT_ALV.

PARAMETERS:P_VBELN TYPE VBAK-VBELN.

START-OF-SELECTION.
  SELECT VBELN, ERDAT, ERZET, ERNAM, ANGDT, BNDDT, AUDAT, VBTYP, TRVOG, AUART,AUGRU
    FROM VBAK INTO TABLE @DATA(IT_VBAK)
*    FROM VBAK INTO CORRESPONDING FIELDS OF TABLE @DATA(IT_VBAK)  // Cant work
    WHERE VBELN = @P_VBELN.

  WA_FCAT-FIELDNAME = 'VBELN'.
  WA_FCAT-COL_POS = '1'.
  WA_FCAT-SELTEXT_L = 'SALS ORDER'.
*  WA_FCAT-HOTSPOT = 'X'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.

  WA_FCAT-FIELDNAME = 'ERDAT'.
  WA_FCAT-COL_POS = '2'.
  WA_FCAT-SELTEXT_L = 'Date on Which Record Was Created'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.

  WA_FCAT-FIELDNAME = 'ERZET'.
  WA_FCAT-COL_POS = '3'.
  WA_FCAT-SELTEXT_L = 'Entry time'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.


  WA_FCAT-FIELDNAME = 'ERNAM'.
  WA_FCAT-COL_POS = '4'.
  WA_FCAT-SELTEXT_L = 'Name of Person Who Created the Object'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.

    WA_FCAT-FIELDNAME = 'ANGDT'.
  WA_FCAT-COL_POS = '5'.
  WA_FCAT-SELTEXT_L = 'Quotation/Inquiry is valid from'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.


  WA_FCAT-FIELDNAME = 'BNDDT'.
  WA_FCAT-COL_POS = '6'.
  WA_FCAT-SELTEXT_L = 'Date until which bid/quotation is binding (valid-to date)'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.


  WA_FCAT-FIELDNAME = 'AUDAT'.
  WA_FCAT-COL_POS = '7'.
  WA_FCAT-SELTEXT_L = 'Document Date (Date Received/Sent)'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.


  WA_FCAT-FIELDNAME = 'VBTYP'.
  WA_FCAT-COL_POS = '8'.
  WA_FCAT-SELTEXT_L = 'SD document category'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.


  WA_FCAT-FIELDNAME = 'TRVOG'.
  WA_FCAT-COL_POS = '9'.
  WA_FCAT-SELTEXT_L = 'Transaction group'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.


  WA_FCAT-FIELDNAME = 'AUART'.
  WA_FCAT-COL_POS = '10'.
  WA_FCAT-SELTEXT_L = 'Sales Document Type'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.

  WA_FCAT-FIELDNAME = 'AUGRU'.
  WA_FCAT-COL_POS = '11'.
  WA_FCAT-SELTEXT_L = 'Order reason (reason for the business transaction)'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.

  CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
    EXPORTING
      I_CALLBACK_PROGRAM      = 'ZALV_REPORT_SK12_HOTSPOT'
      I_CALLBACK_USER_COMMAND = 'DISPLAY_F'
      IT_FIELDCAT             = IT_FCAT
    TABLES
      T_OUTTAB                = IT_VBAK.

FORM DISPLAY_F USING SHUBHAM TYPE SY-UCOMM SEL_FILED TYPE SLIS_SELFIELD.
  CASE SHUBHAM.
    WHEN '&IC1'.
      SET PARAMETER ID 'AUN' FIELD SEL_FILED-VALUE.
      CALL TRANSACTION 'VA03'.
  ENDCASE.
ENDFORM.