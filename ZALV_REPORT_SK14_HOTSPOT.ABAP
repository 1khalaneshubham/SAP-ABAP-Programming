*&---------------------------------------------------------------------*
*& Report ZALV_REPORT_SK14_HOTSPOT
*&---------------------------------------------------------------------*
REPORT ZALV_REPORT_SK14_HOTSPOT.

TABLES:LFA1.

TYPES: BEGIN OF STR_LFA1,
         LIFNR TYPE LFA1-LIFNR,
         LAND1 TYPE LFA1-LAND1,
         NAME1 TYPE LFA1-NAME1,
         ORT01 TYPE LFA1-ORT01,
         ORT02 TYPE LFA1-ORT02,
         PFACH TYPE LFA1-PFACH,
         PSTL2 TYPE LFA1-PSTL2,
         PSTLZ TYPE LFA1-PSTLZ,
         REGIO TYPE LFA1-REGIO,
         STRAS TYPE LFA1-STRAS,
         ADRNR TYPE LFA1-ADRNR,
         MCOD1 TYPE LFA1-MCOD1,
         BAHNS TYPE LFA1-BAHNS,
         DTAMS TYPE LFA1-DTAMS,
       END OF STR_LFA1.

DATA:IT_FCAT TYPE SLIS_T_FIELDCAT_ALV,
     WA_FCAT TYPE SLIS_FIELDCAT_ALV.

SELECTION-SCREEN BEGIN OF BLOCK B1 WITH FRAME TITLE TEXT-001.
SELECT-OPTIONS:S_LIFNR FOR LFA1-LIFNR.
SELECTION-SCREEN END OF BLOCK B1.

START-OF-SELECTION.
  SELECT LIFNR,LAND1,NAME1,ORT01,ORT02,PFACH,PSTLZ,REGIO,STRAS,ADRNR,MCOD1,BAHNS,DTAMS
    FROM LFA1 INTO TABLE @DATA(IT_LFA1)
    WHERE LIFNR IN @S_LIFNR.

*   Field Catalog Automatically
  CALL FUNCTION 'REUSE_ALV_FIELDCATALOG_MERGE'
    EXPORTING
      I_PROGRAM_NAME         = SY-REPID
      I_STRUCTURE_NAME       = 'ZSTR_LFA10' "Create a STR for that all field"
    CHANGING
      CT_FIELDCAT            = IT_FCAT
    EXCEPTIONS
      INCONSISTENT_INTERFACE = 1
      PROGRAM_ERROR          = 2
      OTHERS                 = 3.

  CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
    EXPORTING
      I_CALLBACK_PROGRAM      = 'ZALV_REPORT_SK14_HOTSPOT'
      I_CALLBACK_USER_COMMAND = 'DISPLAY_F'
      IT_FIELDCAT             = IT_FCAT
    TABLES
      T_OUTTAB                = IT_LFA1.

* User Command
FORM DISPLAY_F USING RCOM TYPE SY-UCOMM SEL_FILED TYPE SLIS_SELFIELD.
  CASE RCOM.
    WHEN '&IC1'.
      SET PARAMETER ID 'LIF' FIELD SEL_FILED-VALUE.
      CALL TRANSACTION  'MK03'.
  ENDCASE.
ENDFORM.