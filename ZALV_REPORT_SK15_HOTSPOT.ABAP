*&---------------------------------------------------------------------*
*& Report ZALV_REPORT_SK15_HOTSPOT
*&---------------------------------------------------------------------*
REPORT ZALV_REPORT_SK15_HOTSPOT LINE-SIZE 120 LINE-COUNT 65(3).

TABLES:T005.

DATA:IT_FCAT TYPE SLIS_T_FIELDCAT_ALV.

SELECTION-SCREEN BEGIN OF BLOCK B1 WITH FRAME TITLE TEXT-001.
SELECT-OPTIONS:S_LAND1 FOR T005-LAND1.
SELECTION-SCREEN END OF BLOCK B1.

CALL FUNCTION 'REUSE_ALV_FIELDCATALOG_MERGE'
  EXPORTING
    I_PROGRAM_NAME         = 'ZALV_REPORT_SK15_HOTSPOT'
    I_STRUCTURE_NAME       = 'ZSTR_T005'
  CHANGING
    CT_FIELDCAT            = IT_FCAT
  EXCEPTIONS
    INCONSISTENT_INTERFACE = 1
    PROGRAM_ERROR          = 2
    OTHERS                 = 3.

START-OF-SELECTION.
  SELECT LAND1,LANDK,LNPLZ,PRPLZ,ADDRS,XPLPF,SPRAS,XLAND,XPLZS
    FROM T005 INTO TABLE @DATA(IT_T001)
    WHERE LAND1 IN @S_LAND1.

  CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
    EXPORTING
      I_CALLBACK_PROGRAM      = 'ZALV_REPORT_SK15_HOTSPOT'
      I_CALLBACK_USER_COMMAND = 'DISPLAY_F'
      IT_FIELDCAT             = IT_FCAT
    TABLES
      T_OUTTAB                = IT_T001.

FORM DISPLAY_F USING RCOM TYPE SY-UCOMM SEL_FILED TYPE SLIS_SELFIELD.
  CASE RCOM.
    WHEN '&IC1'.
      SET PARAMETER ID 'LND' FIELD SEL_FILED-VALUE.
      CALL TRANSACTION 'SE16N'.
  ENDCASE.
ENDFORM.