*&---------------------------------------------------------------------*
*& Report ZALV_REPORT_SK8_VBAK: PP Sir Task ( ALV)
*&---------------------------------------------------------------------*
REPORT ZALV_REPORT_SK8_VBAK.

TABLES:VBAK.

TYPES: BEGIN OF STR_VBAK,
         VBELN TYPE VBAK-VBELN,
         ERDAT TYPE VBAK-ERDAT,
         ERZET TYPE VBAK-ERZET,
         ERNAM TYPE VBAK-ERNAM,
         ANGDT TYPE VBAK-ANGDT,
         BNDDT TYPE VBAK-BNDDT,
         AUDAT TYPE VBAK-AUDAT,
         VBTYP TYPE VBAK-VBTYP,
         TRVOG TYPE VBAK-TRVOG,
         AUART TYPE VBAK-AUART,
         AUGRU TYPE VBAK-AUGRU,
       END OF STR_VBAK.

DATA: IT_VBAK TYPE TABLE OF STR_VBAK,
      WA_VBAK TYPE STR_VBAK,
      IT_FCAT TYPE SLIS_T_FIELDCAT_ALV,
      WA_FCAT TYPE SLIS_FIELDCAT_ALV.


SELECTION-SCREEN BEGIN OF BLOCK B1 WITH FRAME TITLE TEXT-001.
SELECT-OPTIONS:S_VBELN FOR VBAK-VBELN,
               S_ERDAT FOR VBAK-ERDAT.

SELECTION-SCREEN END OF BLOCK B1.

START-OF-SELECTION.
  SELECT
    VBELN
    ERDAT
    ERZET
    ERNAM
    ANGDT
    BNDDT
    AUDAT
    VBTYP
    TRVOG
    AUART
    AUGRU
    FROM VBAK
    INTO CORRESPONDING FIELDS OF TABLE IT_VBAK
    WHERE VBAK~VBELN In S_VBELN
    AND  VBAK~ERDAT In S_ERDAT.

  WA_FCAT-COL_POS    = 1.
  WA_FCAT-FIELDNAME  = 'VBELN'.
  WA_FCAT-SELTEXT_L  = 'Sales Document'.
  WA_FCAT-OUTPUTLEN  = 15.
  WA_FCAT-JUST       = 'C'.
  WA_FCAT-KEY        = 'X'.
*WA_FCAT-HOTSPOT    = 'X'.
  WA_FCAT-EMPHASIZE  = 'C510'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.


  WA_FCAT-COL_POS    = 2.
  WA_FCAT-FIELDNAME  = 'ERDAT'.
  WA_FCAT-SELTEXT_L  = 'Created On'.
  WA_FCAT-OUTPUTLEN  = 12.
  WA_FCAT-JUST       = 'C'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.

  WA_FCAT-COL_POS    = 3.
  WA_FCAT-FIELDNAME  = 'ERZET'.
  WA_FCAT-SELTEXT_L  = 'Created At'.
  WA_FCAT-SELTEXT_M  = 'Created At'.
  WA_FCAT-SELTEXT_S  = 'Time'.
  WA_FCAT-OUTPUTLEN  = 10.
  WA_FCAT-JUST       = 'C'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.


  WA_FCAT-COL_POS    = 4.
  WA_FCAT-FIELDNAME  = 'ERNAM'.
  WA_FCAT-SELTEXT_L  = 'Created By'.
  WA_FCAT-OUTPUTLEN  = 12.
  WA_FCAT-JUST       = 'C'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.

  WA_FCAT-COL_POS    = 5.
  WA_FCAT-FIELDNAME  = 'ANGDT'.
  WA_FCAT-SELTEXT_L  = 'Valid From'.
  WA_FCAT-OUTPUTLEN  = 12.
  WA_FCAT-JUST       = 'C'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.

  WA_FCAT-COL_POS    = 6.
  WA_FCAT-FIELDNAME  = 'BNDDT'.
  WA_FCAT-SELTEXT_L  = 'Valid To'.
  WA_FCAT-OUTPUTLEN  = 12.
  WA_FCAT-JUST       = 'C'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.


  WA_FCAT-FIELDNAME  = 'AUDAT'.
  WA_FCAT-SELTEXT_L  = 'Document Date'.
  WA_FCAT-OUTPUTLEN  = 12.
  WA_FCAT-JUST       = 'C'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.

  WA_FCAT-COL_POS    = 8.
  WA_FCAT-FIELDNAME  = 'VBTYP'.
  WA_FCAT-SELTEXT_L  = 'Document Category'.
  WA_FCAT-OUTPUTLEN  = 15.
  WA_FCAT-JUST       = 'C'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.

  WA_FCAT-COL_POS    = 9.
  WA_FCAT-FIELDNAME  = 'TRVOG'.
  WA_FCAT-SELTEXT_L  = 'Transaction Group'.
  WA_FCAT-OUTPUTLEN  = 15.
  WA_FCAT-JUST       = 'C'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.

  WA_FCAT-COL_POS    = 10.
  WA_FCAT-FIELDNAME  = 'AUART'.
  WA_FCAT-SELTEXT_L  = 'Sales Document Type'.
  WA_FCAT-OUTPUTLEN  = 18.
  WA_FCAT-JUST       = 'C'.
  WA_FCAT-EMPHASIZE  = 'C410'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.

  WA_FCAT-COL_POS    = 11.
  WA_FCAT-FIELDNAME  = 'AUGRU'.
  WA_FCAT-SELTEXT_L  = 'Order Reason'.
  WA_FCAT-OUTPUTLEN  = 15.
  WA_FCAT-JUST       = 'C'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.


  CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
    EXPORTING
      I_CALLBACK_PROGRAM = SY-REPID
      IT_FIELDCAT        = IT_FCAT
    TABLES
      T_OUTTAB           = IT_VBAK.