*&---------------------------------------------------------------------*
*& Report ZALV_REPORT_EMPDATA_88H
*&---------------------------------------------------------------------*
REPORT ZALV_REPORT_EMPDATA_88H.

TABLES: ZEMPDATA_88H.

TYPES: BEGIN OF SD_ZEMPDATA_88H,
         EMP_ID     TYPE ZEMPDATA_88H-EMP_ID,
         EMP_NAME   TYPE ZEMPDATA_88H-EMP_NAME,
         DEPARTMENT TYPE ZEMPDATA_88H-DEPARTMENT,
         SALARY     TYPE ZEMPDATA_88H-SALARY,
         EMAIL      TYPE ZEMPDATA_88H-EMAIL,
         MOBILE_NO  TYPE ZEMPDATA_88H-MOBILE_NO,
         CITY       TYPE ZEMPDATA_88H-CITY,
       END OF SD_ZEMPDATA_88H.

DATA: IT_EMP  TYPE TABLE OF SD_ZEMPDATA_88H,
      WA_EMP  TYPE SD_ZEMPDATA_88H,
      IT_FCAT TYPE SLIS_T_FIELDCAT_ALV,
      WA_FCAT TYPE SLIS_FIELDCAT_ALV.

SELECT-OPTIONS: P_STUDID FOR ZEMPDATA_88H-EMP_ID.

START-OF-SELECTION.

  SELECT EMP_ID
         EMP_NAME
         DEPARTMENT
         SALARY
         EMAIL
         MOBILE_NO
         CITY
    FROM ZEMPDATA_88H
    INTO TABLE IT_EMP
    WHERE EMP_ID IN P_STUDID.


  WA_FCAT-COL_POS = 1.
  WA_FCAT-SELTEXT_L = 'EMP ID'.
  WA_FCAT-FIELDNAME = 'EMP_ID'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.

  WA_FCAT-COL_POS = 2.
  WA_FCAT-SELTEXT_L = 'EMP NAME'.
  WA_FCAT-FIELDNAME = 'EMP_NAME'.
  WA_FCAT-EDIT = 'x'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.

  WA_FCAT-COL_POS = 3.
  WA_FCAT-SELTEXT_L = 'DEPARTMENT'.
  WA_FCAT-FIELDNAME = 'DEPARTMENT'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.

  WA_FCAT-COL_POS = 4.
  WA_FCAT-SELTEXT_L = 'SALARY'.
  WA_FCAT-FIELDNAME = 'SALARY'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.

  WA_FCAT-COL_POS = 5.
  WA_FCAT-SELTEXT_L = 'EMAIL'.
  WA_FCAT-FIELDNAME = 'EMAIL'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.

  WA_FCAT-COL_POS = 6.
  WA_FCAT-SELTEXT_L = 'MOBILE NO'.
  WA_FCAT-FIELDNAME = 'MOBILE_NO'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.

  WA_FCAT-COL_POS = 7.
  WA_FCAT-SELTEXT_L = 'CITY'.
  WA_FCAT-FIELDNAME = 'CITY'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR WA_FCAT.


  CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
    EXPORTING
      I_CALLBACK_PROGRAM = SY-REPID
      I_CALLBACK_USER_COMMAND = 'SAVE'
      IT_FIELDCAT        = IT_FCAT
    TABLES
      T_OUTTAB           = IT_EMP.

  IF SY-SUBRC <> 0.
    " Error handling
  ENDIF.

  FROM SAVE USING RCOMM TYPE SY-UCOMM SEL_FLEID
        TYPE SLIS_SELFIELD.
  ENDFORM.