*&---------------------------------------------------------------------*
*& Report ZALV_REPORT_SK10_VBAK: Without FCAT DATA Pass
*&---------------------------------------------------------------------*
REPORT ZALV_REPORT_SK10_VBAK.

TABLES:VBAK.

DATA: IT_VBAK TYPE TABLE OF ZSTR_VBAK_001,
      WA_VBAK TYPE ZSTR_VBAK_001.

SELECTION-SCREEN BEGIN OF BLOCK B1 WITH FRAME TITLE TEXT-001.
SELECT-OPTIONS:S_VBELN FOR VBAK-VBELN,
               S_ERDAT FOR VBAK-ERDAT.
SELECTION-SCREEN END OF BLOCK B1.

START-OF-SELECTION.
  SELECT VBELN ERDAT ERZET ERNAM ANGDT BNDDT AUDAT VBTYP TRVOG AUART AUGRU
    FROM VBAK
    INTO CORRESPONDING FIELDS OF TABLE IT_VBAK
    WHERE VBAK~VBELN In S_VBELN
    AND  VBAK~ERDAT In S_ERDAT.

CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
 EXPORTING
   I_CALLBACK_PROGRAM                = 'ZALV_REPORT_SK10_VBAK'
   I_STRUCTURE_NAME                  = 'ZSTR_VBAK_001'
  TABLES
    T_OUTTAB                          = IT_VBAK.