REPORT ZALV_REPORT_SK13_HOTSPOT.
TABLES:MARA.

TYPES: BEGIN OF STR_MARA,
         MATNR TYPE MARA-MATNR,
         ERSDA TYPE MARA-ERSDA,
         ERNAM TYPE MARA-ERNAM,
         LAEDA TYPE MARA-LAEDA,
         AENAM TYPE MARA-AENAM,
         VPSTA TYPE MARA-VPSTA,
         PSTAT TYPE MARA-PSTAT,
         LVORM TYPE MARA-LVORM,
         MTART TYPE MARA-MTART,
         MBRSH TYPE MARA-MBRSH,
       END OF STR_MARA.

DATA:IT_FCAT TYPE SLIS_T_FIELDCAT_ALV,
     WA_FCAT TYPE SLIS_FIELDCAT_ALV.

SELECT-OPTIONS:S_MATNR FOR MARA-MATNR.

START-OF-SELECTION.
  SELECT MATNR,ERSDA,ERNAM,LAEDA,AENAM,VPSTA,PSTAT,LVORM,MTART,MBRSH
    FROM MARA INTO TABLE @DATA(IT_MARA)
    WHERE MATNR IN @S_MATNR.

  WA_FCAT-FIELDNAME = 'MATNR'.
  WA_FCAT-COL_POS = '1'.
  WA_FCAT-SELTEXT_L = 'SALS ORDER'.
*  WA_FCAT-HOTSPOT = 'X'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.

  WA_FCAT-FIELDNAME = 'ERSDA'.
  WA_FCAT-COL_POS = '2'.
  WA_FCAT-SELTEXT_L = 'SALS ORDER'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.

  WA_FCAT-FIELDNAME = 'ERNAM'.
  WA_FCAT-COL_POS = '3'.
  WA_FCAT-SELTEXT_L = 'SALS ORDER'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.

  WA_FCAT-FIELDNAME = 'LAEDA'.
  WA_FCAT-COL_POS = '4'.
  WA_FCAT-SELTEXT_L = 'SALS ORDER'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.

  WA_FCAT-FIELDNAME = 'AENAM'.
  WA_FCAT-COL_POS = '5'.
  WA_FCAT-SELTEXT_L = 'SALS ORDER'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.

  WA_FCAT-FIELDNAME = 'VPSTA'.
  WA_FCAT-COL_POS = '6'.
  WA_FCAT-SELTEXT_L = 'SALS ORDER'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.

  WA_FCAT-FIELDNAME = 'PSTAT'.
  WA_FCAT-COL_POS = '7'.
  WA_FCAT-SELTEXT_L = 'SALS ORDER'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.

  WA_FCAT-FIELDNAME = 'LVORM'.
  WA_FCAT-COL_POS = '8'.
  WA_FCAT-SELTEXT_L = 'SALS ORDER'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.

  WA_FCAT-FIELDNAME = 'MTART'.
  WA_FCAT-COL_POS = '9'.
  WA_FCAT-SELTEXT_L = 'SALS ORDER'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.

  WA_FCAT-FIELDNAME = 'MBRSH'.
  WA_FCAT-COL_POS = '10'.
  WA_FCAT-SELTEXT_L = 'SALS ORDER'.
  APPEND WA_FCAT TO IT_FCAT.
  CLEAR:WA_FCAT.


  CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
    EXPORTING
      I_CALLBACK_PROGRAM      = 'ZALV_REPORT_SK13_HOTSPOT'
      I_CALLBACK_USER_COMMAND = 'DISPLAY_F'
      IT_FIELDCAT             = IT_FCAT
    TABLES
      T_OUTTAB                = IT_MARA.

FORM DISPLAY USING CMM TYPE SY-UCOMM SEL_FILED TYPE SLIS_SELFIELD.
  CASE CMM.
    WHEN '&IC1'.
      SET PARAMETER ID 'MAT' FIELD SEL_FILED-VALUE.
      CALL TRANSACTION 'MM02'.
  ENDCASE.
ENDFORM.

